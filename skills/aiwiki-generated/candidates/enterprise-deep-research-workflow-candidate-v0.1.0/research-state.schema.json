{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwiki.local/schemas/enterprise-deep-research-state.schema.json",
  "title": "Enterprise Deep Research State",
  "type": "object",
  "required": [
    "version",
    "createdAt",
    "question",
    "mode",
    "status",
    "lanes",
    "sources",
    "claims"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "question": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "quick",
        "standard",
        "deep",
        "ultra"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "retrieving",
        "triangulating",
        "synthesizing",
        "validating",
        "complete",
        "blocked"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "locator",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "authority": {
            "type": "string"
          },
          "credibilityScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "freshnessScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "summary": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "status",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "supportingSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradictingSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
